# Copy this file to .env and fill in the values before running docker compose.

# ── PostgreSQL (running on host or external) ──────────────────
# On Windows/macOS with Docker Desktop, host.docker.internal resolves automatically.
# On Linux, the extra_hosts entry in docker-compose.yml handles this.
RAG_DB_HOST=host.docker.internal
RAG_DB_PORT=5432
RAG_DB_NAME=ragdb
RAG_DB_USER=rag_app
RAG_DB_PASS=change_me_app

# ── Embedding model ───────────────────────────────────────────
EMBED_MODEL=BAAI/bge-m3

# ── Ports (override if needed) ───────────────────────────────
RAG_PORT=7071
MCP_PORT=3000

# ── Published interfaces (shared server: keep the rag-server local) ─────────
RAG_BIND_HOST=0.0.0.0
MCP_BIND_HOST=0.0.0.0

# ── Retrieval tuning (defaults chosen with scripts/eval_retrieval.py) ──────
RAG_W_DENSE=1.0
RAG_W_FTS=0.3
RAG_RRF_K=60
